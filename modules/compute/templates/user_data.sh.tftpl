#!/bin/bash
# First-boot script of the web tier (Amazon Linux 2023) - spec page 10, section 21
set -euxo pipefail

dnf install -y nginx

# Instance identity through IMDSv2 (IMDSv1 is disabled in the launch template)
TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
md() { curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/$1"; }
INSTANCE_ID=$(md instance-id)
AZ=$(md placement/availability-zone)
PRIVATE_IP=$(md local-ipv4)
HOST=$(hostname)

# Proves the app tier can reach RDS (the Internet cannot)
DB_STATUS="not configured"
if [ -n "${db_host}" ]; then
  if timeout 3 bash -c "</dev/tcp/${db_host}/${db_port}"; then
    DB_STATUS="reachable from the app tier"
  else
    DB_STATUS="not reachable"
  fi
fi

cat > /usr/share/nginx/html/index.html <<EOF
<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><title>${project} - ${environment}</title>
<style>
body{font-family:system-ui,sans-serif;background:#0f172a;color:#e2e8f0;display:flex;justify-content:center;padding-top:8vh}
.card{background:#1e293b;border-radius:12px;padding:32px 40px;min-width:420px}
td{padding:6px 16px 6px 0} td:first-child{color:#94a3b8}
</style></head>
<body><div class="card">
<h1>Terraform Cloud Project</h1>
<table>
<tr><td>Environment</td><td>${environment}</td></tr>
<tr><td>Host</td><td>$HOST</td></tr>
<tr><td>Instance ID</td><td>$INSTANCE_ID</td></tr>
<tr><td>Availability zone</td><td>$AZ</td></tr>
<tr><td>Private IP</td><td>$PRIVATE_IP</td></tr>
<tr><td>Database</td><td>$DB_STATUS</td></tr>
</table>
</div></body></html>
EOF

systemctl enable --now nginx
